CREATE DATABASE pg_management;

USE pg_management;

CREATE TABLE students(
id INT AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(100),
mobile VARCHAR(20),
room_no VARCHAR(20),
rent DECIMAL(10,2),
username VARCHAR(50),
password VARCHAR(255)
);

CREATE TABLE payments(
id INT AUTO_INCREMENT PRIMARY KEY,
student_id INT,
amount DECIMAL(10,2),
payment_date DATE,
month_name VARCHAR(30)
);
